{
  "name": "treaty",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run compile && vite",
    "build": "npm run compile && vite build && node scripts/build-worker.js",
    "build:site": "npm run compile && vite build",
    "preview": "vite preview",
    "compile": "node scripts/compile.js",
    "test": "npm run compile && node --test test/treaty.test.js test/native.test.js test/smart-account.test.js test/qorex.test.js test/seal.test.js",
    "e2e": "npm run compile && node --test test/e2e.test.js",
    "demo": "npm run compile --silent && node --env-file-if-exists=.env.diana examples/agents-demo.js",
    "accounts": "npm run compile --silent && node scripts/accounts.js",
    "check:diana": "npm run compile --silent && node scripts/check-diana.js",
    "deploy": "npm run compile && node --env-file-if-exists=.env scripts/deploy.js",
    "pq": "npm run compile --silent && node --env-file-if-exists=.env scripts/treaty.js",
    "demo:session": "npm run compile --silent && node --env-file-if-exists=.env.diana examples/smart-account-demo.js"
  },
  "dependencies": {
    "@cosmjs/stargate": "0.39.0",
    "@noble/curves": "1.9.1",
    "@qorechain/evm": "0.14.0",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qorex-types": "0.1.0",
    "@qorechain/sdk": "0.14.0",
    "@scure/base": "1.2.6",
    "viem": "2.55.18"
  },
  "devDependencies": {
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/qorex-wallet-mock": "0.1.0",
    "hardhat": "2.30.0",
    "solc": "0.8.39",
    "vite": "6.4.5"
  },
  "overrides": {
    "rollup": "4.67.4",
    "esbuild": "0.25.12",
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "homepage": "https://treatyv1.vercel.app"
}
